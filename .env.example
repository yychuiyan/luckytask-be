# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=luckytask

# JWT 密钥（必填，部署时自己生成随机字符串：openssl rand -hex 32）
JWT_SECRET=

# 后端端口
PORT=3000

# CORS 允许的前端地址（多个用逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# GitHub热力图
GITHUB_TOKEN=

# 环境类型（production 时关闭 synchronize）
NODE_ENV=development
